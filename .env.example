# SmartShop Elite - Environment Variables
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────────────────────────────────────
# REQUIRED: LLM API Keys
# ─────────────────────────────────────────────────────────────────────────────
# Google Gemini (primary LLM)
GOOGLE_API_KEY="AIzaSy..."

# OpenAI (fallback LLM — optional)
# OPENAI_API_KEY="sk-..."

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: LangSmith Observability
# ─────────────────────────────────────────────────────────────────────────────
LANGCHAIN_TRACING_V2="true"
LANGCHAIN_API_KEY="ls__..."
LANGCHAIN_PROJECT="SmartShop-Elite"

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL: Redis (background processing & session caching)
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379/0"

# ─────────────────────────────────────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────────────────────────────────────
# Embedding model (must match build_vector_db.py)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Vector DB path (relative to project root)
VECTOR_DB_PATH="./vector_db"

# Dataset directory
DATASET_DIR="./dataset"

# Max products per search result
SEARCH_TOP_K=5

# Debug mode (set to "true" to enable verbose logging)
DEBUG_MODE="false"
